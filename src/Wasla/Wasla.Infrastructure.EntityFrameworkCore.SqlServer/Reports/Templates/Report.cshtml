@model Wasla.Application.Features.Reporting.ReportPresentation
@using System.Globalization
@using Wasla.Infrastructure.EntityFrameworkCore.SqlServer.Reports
@{
    var p = Model;
    var r = p.Report;
    string T(string en, string ar) => p.IsArabic ? ar : en;
}
<!doctype html>
<html lang="@(p.IsArabic ? "ar" : "en")" dir="@(p.IsArabic ? "rtl" : "ltr")">
<head>
<meta charset="utf-8" />
<title>@(p.IsArabic ? r.TitleAr : r.TitleEn)</title>
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; script-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'" />
<style>
@@page { size:A4; }
* { box-sizing:border-box; }
body { font-family:Tahoma,"Segoe UI",Arial,sans-serif; color:#143c50; font-size:10px; line-height:1.5; margin:0; }
header { border-bottom:3px solid #14838c; padding-bottom:10px; margin-bottom:14px; }
.brand { color:#14838c; font-weight:bold; font-size:15px; letter-spacing:2px; }
h1 { font-size:23px; margin:5px 0; }
h2 { font-size:16px; margin:18px 0 8px; break-after:avoid; }
p { margin:4px 0; overflow-wrap:anywhere; }
.meta { display:grid; grid-template-columns:1fr 1fr; gap:6px; color:#456271; }
table { border-collapse:collapse; width:100%; table-layout:fixed; margin-top:8px; }
thead { display:table-header-group; } tr { break-inside:avoid; }
th { color:white; background:#143c50; padding:7px 5px; text-align:start; font-weight:normal; }
td { border-bottom:1px solid #deeaed; padding:6px 5px; vertical-align:top; overflow-wrap:anywhere; }
tbody tr:nth-child(even) { background:#f4f8f9; }
.num { direction:ltr; unicode-bidi:isolate; text-align:end; font-variant-numeric:tabular-nums; }
.note { color:#536f7c; font-size:9px; } .warning { background:#fff3d8; padding:7px; }
.chart { display:grid; grid-template-columns:1fr 1.4fr; gap:14px; break-inside:avoid; }
.chart img { width:100%; height:auto; } .logo { max-width:64px; max-height:48px; float:inline-end; }
.section { break-before:page; } .empty { padding:14px; background:#f4f8f9; }
</style>
</head>
<body>
<header>
@if (p.LogoDataUrl != null) { <img class="logo" src="@p.LogoDataUrl" alt="Logo" /> }
<div class="brand">WASLA</div><h1>@(p.IsArabic ? r.TitleAr : r.TitleEn)</h1>
<div class="meta">
<p>@T("Scope", "النطاق"): @p.ScopeLabel</p><p>@T("Generated by", "أنشأه"): @p.GeneratedBy</p>
<p>@T("Period", "الفترة"): <span dir="ltr">@r.Window.FromDate.ToString("yyyy-MM-dd") - @r.Window.ToDate.ToString("yyyy-MM-dd")</span></p>
<p>@T("Time zone", "المنطقة الزمنية"): @r.Window.ReportTimeZoneId</p>
<p>@T("As of UTC", "كما في UTC"): <span dir="ltr">@r.Window.AsOfUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</span></p>
<p>@T("Generated UTC", "وقت الإنشاء UTC"): <span dir="ltr">@r.Window.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</span></p>
</div>
</header>
<h2>@T("Report summary", "ملخص التقرير")</h2>
<p class="note">@T("Business dates follow the source practice; cash movements follow the displayed report time zone.", "تواريخ التشغيل حسب العيادة وتواريخ الحركات النقدية حسب المنطقة الزمنية للتقرير.")</p>
<table><thead><tr><th style="width:30%">@T("Metric", "المؤشر")</th><th>@T("Value / unit", "القيمة والوحدة")</th><th>@T("Numerator / denominator", "البسط والمقام")</th><th>@T("Eligible / excluded", "المؤهل والمستبعد")</th><th>@T("Data status", "حالة البيانات")</th></tr></thead><tbody>
@foreach (var m in r.Metrics) {
<tr><td>@(p.IsArabic ? m.NameAr : m.NameEn)</td><td class="num">@ReportPresentationText.MetricValue(m) @ReportPresentationText.Unit(m.Unit, p.IsArabic)</td>
<td class="num">@ReportDocumentRenderer.DecimalText(m.Numerator) / @ReportDocumentRenderer.DecimalText(m.Denominator)</td><td class="num">@m.EligibleSampleCount / @m.ExcludedSampleCount</td>
<td>@ReportPresentationText.Status(m.DataStatus.ToString(), p.IsArabic)<br /><span class="note">@m.WarningCode</span></td></tr>
}
</tbody></table>
@if (r.PreviousPeriodComparisons is { Count: > 0 }) {
<h2>@T("Previous-period comparison", "المقارنة بالفترة السابقة")</h2>
<p class="note">@T("Changes in percentage metrics are percentage points; relative change is shown separately.", "تغير مؤشرات النسب يعرض بالنقاط المئوية، والتغير النسبي يعرض مستقلاً.")</p>
<table><thead><tr><th>@T("Metric", "المؤشر")</th><th>@T("Previous period", "الفترة السابقة")</th><th>@T("Current / previous", "الحالي والسابق")</th><th>@T("Absolute change", "التغير المطلق")</th><th>@T("Relative change", "التغير النسبي")</th></tr></thead><tbody>
@foreach (var c in r.PreviousPeriodComparisons) {
var metric = r.Metrics.Single(m => m.MetricCode == c.MetricCode);
<tr><td>@(p.IsArabic ? metric.NameAr : metric.NameEn)<br /><span class="note">@c.WarningCode</span></td>
<td dir="ltr">@c.PreviousFromDate.ToString("yyyy-MM-dd") - @c.PreviousToDate.ToString("yyyy-MM-dd")</td>
<td class="num">@ReportDocumentRenderer.DecimalText(c.CurrentValue) / @ReportDocumentRenderer.DecimalText(c.PreviousValue) @ReportPresentationText.Unit(metric.Unit, p.IsArabic)</td>
<td class="num">@ReportDocumentRenderer.DecimalText(c.AbsoluteChange)</td><td class="num">@ReportDocumentRenderer.DecimalText(c.RelativeChangePercent)%</td></tr>
}
</tbody></table>
}
@if (ReportDocumentRenderer.ChartMetrics(r).Length > 0) {
<h2>@T("Selected percentage KPIs", "مؤشرات النسب المختارة")</h2><div class="chart"><div>
@foreach (var m in ReportDocumentRenderer.ChartMetrics(r)) { <p>@(p.IsArabic ? m.NameAr : m.NameEn): @ReportDocumentRenderer.DecimalText(m.Value)%</p> }
</div><img src="@ReportDocumentRenderer.ChartDataUrl(r)" alt="@T("Percentage KPI bars", "مؤشرات النسب")" /></div>
}
<h2>@T("Applied filters and data quality", "الفلاتر وجودة البيانات")</h2>
<p>@T("Data status", "حالة البيانات"): @ReportPresentationText.Status(r.DataStatus.ToString(), p.IsArabic) · @T("Detail rows", "صفوف التفاصيل"): @r.DetailRowCount</p>
@foreach (var filter in ReportPresentationText.Filters(p)) {
<p class="note"><b>@filter.Label:</b> @filter.Value</p>
}
@foreach (var warning in r.Warnings) { <p class="warning">@warning</p> }
@if (r.Series.Count > 0) {
<h2 class="section">@T("Trends", "الاتجاهات")</h2>
<table><thead><tr><th>@T("Period", "الفترة")</th><th>@T("Metric", "المؤشر")</th><th>@T("Value", "القيمة")</th><th>@T("Data status", "حالة البيانات")</th></tr></thead><tbody>
@foreach (var s in r.Series) { foreach (var m in s.Metrics) { <tr><td>@(p.IsArabic ? s.NameAr : s.NameEn ?? s.Key)</td><td>@(p.IsArabic ? m.NameAr : m.NameEn)</td><td class="num">@ReportPresentationText.MetricValue(m) @ReportPresentationText.Unit(m.Unit, p.IsArabic)</td><td>@ReportPresentationText.Status(m.DataStatus.ToString(), p.IsArabic)</td></tr> } }
</tbody></table>
}
@if (r.Breakdowns.Count > 0) {
<h2 class="section">@T("Breakdowns", "التوزيعات")</h2>
<table><thead><tr><th>@T("Group", "المجموعة")</th><th>@T("Metric", "المؤشر")</th><th>@T("Value", "القيمة")</th><th>@T("Data status", "حالة البيانات")</th></tr></thead><tbody>
@foreach (var s in r.Breakdowns) { foreach (var m in s.Metrics) { <tr><td>@(p.IsArabic ? s.NameAr : s.NameEn ?? s.Key)</td><td>@(p.IsArabic ? m.NameAr : m.NameEn)</td><td class="num">@ReportPresentationText.MetricValue(m) @ReportPresentationText.Unit(m.Unit, p.IsArabic)</td><td>@ReportPresentationText.Status(m.DataStatus.ToString(), p.IsArabic)</td></tr> } }
</tbody></table>
}
<h2 class="section">@T("Authorized details", "التفاصيل المصرح بها")</h2>
@if (r.Records.Count == 0) { <p class="empty">@T("No accessible detail records match these filters.", "لا توجد سجلات تفاصيل متاحة تطابق هذه الفلاتر.")</p> }
else {
<table><thead><tr><th style="width:12%">@T("Resource", "المورد")</th><th style="width:35%">@T("Reference", "المرجع")</th><th>@T("Business date", "تاريخ العمل")</th><th>@T("Status", "الحالة")</th><th>@T("Amount EGP", "القيمة جنيه")</th></tr></thead><tbody>
@foreach (var item in r.Records) { <tr><td>@ReportPresentationText.Resource(item.ResourceType, p.IsArabic)</td><td dir="ltr">@item.Reference</td><td dir="ltr">@item.BusinessDate.ToString("yyyy-MM-dd")</td><td>@ReportPresentationText.Status(item.Status, p.IsArabic)</td><td class="num">@(item.Amount?.ToString("#,##0.00", CultureInfo.InvariantCulture) ?? "-")</td></tr> }
</tbody></table>
}
</body></html>
