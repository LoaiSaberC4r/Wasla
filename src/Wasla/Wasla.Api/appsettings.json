{
  "ConnectionStrings": {
    "Database": "Server=(localdb)\\MSSQLLocalDB;Database=WaslaDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 25,
    "UseSsl": false,
    "RequireStartTls": false,
    "UserName": "",
    "Password": "",
    "FromEmail": "no-reply@wasla.local",
    "FromName": "Wasla",
    "MaxAttachmentBytes": 10485760,
    "MaxTotalAttachmentBytes": 26214400,
    "MaxRecipients": 100,
    "MaxAttachments": 20,
    "TimeoutMilliseconds": 100000
  },
  "EmailOutbox": {
    "Enabled": false,
    "PollingIntervalSeconds": 15,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "ClaimLeaseSeconds": 300
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": false
  },
  "Localization": {
    "SupportedCultures": [
      "ar",
      "en"
    ],
    "DefaultCulture": "ar",
    "AllowQueryStringLang": true
  },
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowCredentials": false,
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Diagnostics": {
      "Enabled": false
    },
    "Requests": {
      "IncludeClientIp": false,
      "IncludeUserAgent": true,
      "IncludeQueryString": false,
      "IncludeRequestHeaders": false,
      "IncludeResponseHeaders": false,
      "AllowedRequestHeaders": [],
      "AllowedResponseHeaders": [],
      "ExcludedPaths": [
        "/health"
      ]
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/Wasla-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 14
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*"
}
