{
  "ConnectionStrings": {
    "Database": "Server=(localdb)\\MSSQLLocalDB;Database=WaslaDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 25,
    "UseSsl": false,
    "RequireStartTls": false,
    "UserName": "",
    "Password": "",
    "FromEmail": "no-reply@wasla.local",
    "FromName": "Wasla",
    "MaxAttachmentBytes": 10485760,
    "MaxTotalAttachmentBytes": 26214400,
    "MaxRecipients": 100,
    "MaxAttachments": 20,
    "TimeoutMilliseconds": 100000
  },
  "EmailOutbox": {
    "Enabled": false,
    "PollingIntervalSeconds": 15,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "ClaimLeaseSeconds": 300
  },
  "Jwt": {
    "Issuer": "Wasla",
    "Audience": "Wasla.Api",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "PasswordReset": {
    "OtpLength": 6,
    "OtpExpirationMinutes": 5,
    "MaximumVerificationAttempts": 5,
    "ResendCooldownSeconds": 60,
    "ResetTokenExpirationMinutes": 10,
    "HmacSecret": ""
  },
  "RootSuperAdmin": {
    "UserName": "",
    "Email": "",
    "PhoneNumber": "",
    "NameAr": "",
    "NameEn": "",
    "Password": ""
  },
  "EmailBranding": {
    "FooterImageUrl": "https://api.wasla.example/email-assets/wasla-email-footer.png"
  },
  "MediaStorage": {
    "RootPath": "App_Data/Media",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".pdf" ],
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/gif", "application/pdf" ]
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": false,
    "ApplySeedingOnStartup": false
  },
  "Localization": {
    "SupportedCultures": [
      "ar",
      "en"
    ],
    "DefaultCulture": "en",
    "AllowQueryStringLang": true
  },
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowCredentials": false,
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Diagnostics": {
      "Enabled": false
    },
    "Requests": {
      "IncludeClientIp": false,
      "IncludeUserAgent": true,
      "IncludeQueryString": false,
      "IncludeRequestHeaders": false,
      "IncludeResponseHeaders": false,
      "AllowedRequestHeaders": [],
      "AllowedResponseHeaders": [],
      "ExcludedPaths": [
        "/health"
      ]
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/Wasla-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 14
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*"
}
