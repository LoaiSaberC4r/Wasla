@model Wasla.Application.Features.Reporting.ReportPresentation
@using System.Globalization
@using Wasla.Application.Features.Reporting
@using Wasla.Infrastructure.EntityFrameworkCore.SqlServer.Reports
@{
    var p = Model; var r = p.Report; var print = PdfPrintPresentation.Build(p);
    var comparisons = r.AppliedFilters.ComparePreviousPeriod
        ? (r.PreviousPeriodComparisons ?? Array.Empty<ReportComparison>()).Where(c => print.Cards.Any(m => m.MetricCode == c.MetricCode)).DistinctBy(c => c.MetricCode).Take(5).ToArray() : Array.Empty<ReportComparison>();
    var filters = ReportPresentationText.Filters(p).Where(f => !Guid.TryParse(f.Value, out _)).Take(8).ToArray();
    string T(string en, string ar) => p.IsArabic ? ar : en;
    string N(decimal? n) => PdfPrintPresentation.Number(n);
}
<!doctype html>
<html lang="@(p.IsArabic ? "ar" : "en")" dir="@(p.IsArabic ? "rtl" : "ltr")">
<head><meta charset="utf-8" /><title>@(p.IsArabic ? r.TitleAr : r.TitleEn)</title>
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; script-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'" />
<style>
@@page { size:A4 @(p.Landscape ? "landscape" : "portrait"); }
:root { --navy:#143c50; --teal:#087d82; --muted:#526976; --surface:#f2f6f7; --warning:#fff3da; }
* { box-sizing:border-box; }
body { font-family:Tahoma,"Segoe UI",Arial,sans-serif; color:var(--navy); font-size:10.5pt; line-height:1.45; margin:0; }
header { border-bottom:2pt solid var(--teal); padding-bottom:3mm; margin-bottom:3mm; }
.brand { color:var(--teal); font-weight:bold; font-size:11pt; letter-spacing:2px; }
h1 { font-size:21pt; line-height:1.2; margin:2mm 0; } h2 { font-size:13pt; margin:4mm 0 2mm; break-after:avoid; }
p { margin:1mm 0; overflow-wrap:anywhere; } .question { font-size:11pt; }
.meta { display:grid; grid-template-columns:1fr 1fr; gap:1mm 4mm; font-size:9pt; color:var(--muted); margin-top:2mm; }
.logo { max-width:22mm; max-height:16mm; float:inline-end; }
.cards { display:grid; grid-template-columns:repeat(@(Math.Min(p.Landscape ? 4 : 3, Math.Max(1, print.Cards.Count))),minmax(0,1fr)); gap:2mm; margin:3mm 0; }
.card { background:var(--surface); border-top:2pt solid var(--teal); padding:3mm; break-inside:avoid; overflow-wrap:anywhere; }
.card-label { font-size:9pt; } .value { font-size:18pt; line-height:1.3; font-weight:bold; }
.unit { font-size:9pt; } .note { color:var(--muted); font-size:9pt; } .warning { background:var(--warning); border-inline-start:2pt solid #946b19; padding:2mm 3mm; font-size:9pt; }
.empty { background:var(--surface); border:1px solid #dae3e8; padding:3mm; }
.visual { margin:3mm 0; } .visual-heading { break-inside:avoid; break-after:avoid; }
figure { margin:2mm 0; break-inside:avoid; } figure img { display:block; width:100%; height:auto; } figcaption { font-size:9pt; color:var(--muted); }
table { border-collapse:collapse; width:100%; table-layout:fixed; margin:2mm 0 3mm; font-size:9pt; }
thead { display:table-header-group; } tr { break-inside:avoid; } th { color:white; background:var(--navy); padding:2mm; text-align:start; font-weight:normal; }
td { border-bottom:1px solid #dae3e8; padding:2mm; vertical-align:top; overflow-wrap:anywhere; } tbody tr:nth-child(even) { background:var(--surface); }
.num { direction:ltr; unicode-bidi:isolate; text-align:end; font-variant-numeric:tabular-nums; } bdi { unicode-bidi:isolate; }
.methodology { border-top:1pt solid var(--teal); margin-top:4mm; padding-top:2mm; font-size:9pt; }
</style></head><body>
<header>
@if (p.LogoDataUrl != null) { <img class="logo" src="@p.LogoDataUrl" alt="@T("Authorized practice logo", "شعار العيادة المصرح به")" /> }
<div class="brand">WASLA</div><h1>@(p.IsArabic ? r.TitleAr : r.TitleEn)</h1><p class="question">@print.Question</p>
<p class="note">@PdfPrintPresentation.ExecutiveLabel(p.IsArabic)</p>
<div class="meta">
<p>@T("Scope", "النطاق"): @p.ScopeLabel</p><p>@T("Generated by", "أنشأه"): @p.GeneratedBy</p>
<p>@T("Report period", "فترة التقرير"): <bdi dir="ltr">@r.Window.FromDate.ToString("yyyy-MM-dd") – @r.Window.ToDate.ToString("yyyy-MM-dd")</bdi></p>
<p>@T("Report zone", "منطقة التقرير"): <bdi>@r.Window.ReportTimeZoneId</bdi></p>
<p>@T("As-of snapshot", "لقطة البيانات"): <bdi dir="ltr">@r.Window.AsOfUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</bdi></p>
<p>@T("Generated on", "وقت الإنشاء"): <bdi dir="ltr">@r.Window.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</bdi></p>
<p>@T("Data freshness UTC", "حداثة البيانات UTC"): <bdi dir="ltr">@r.DataFreshnessUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</bdi></p>
</div></header>
@if (print.QualityNotes.Count > 0) { <aside class="warning">@T("Source limitations apply; review data quality before interpreting this summary.", "توجد قيود للمصدر؛ راجع جودة البيانات قبل تفسير الملخص.")</aside> }
@if (print.Cards.Count > 0) {
<div class="cards">
@foreach (var m in print.Cards) {
<div class="card" data-card="@m.MetricCode"><div class="card-label">@PdfPrintPresentation.Name(m, p.IsArabic)</div>
<div class="value"><bdi dir="ltr">@PdfPrintPresentation.Value(m)</bdi></div><div class="unit">@ReportPresentationText.Unit(m.Unit, p.IsArabic)</div>
@if (m.DataStatus != ReportDataStatus.NotAvailable && (m.Numerator.HasValue || m.Denominator.HasValue)) { <p class="note">@T("Basis", "الأساس"): <bdi dir="ltr">@N(m.Numerator) / @N(m.Denominator)</bdi></p> }
@if (!PdfPrintPresentation.Measured(m) || m.DataStatus != ReportDataStatus.Complete) { <p class="note">@PdfPrintPresentation.MetricState(m, p.IsArabic)</p> }
@if (m.WarningCode != null) { <p class="note">@PdfPrintPresentation.Warning(m.WarningCode, p.IsArabic)</p> }
</div>
}
</div>
} else { <p class="empty">@T("No headline measures were supplied. Review the source quality and filters below.", "لا توجد مقاييس رئيسية واردة. راجع جودة المصدر والفلاتر أدناه.")</p> }
@foreach (var visual in print.Sections) {
<section class="visual"><div class="visual-heading"><h2>@visual.Title</h2><p class="note">@visual.Caption</p></div>
@if (visual.ChartDataUrl != null) {
<figure><img src="@visual.ChartDataUrl" alt="@visual.Title" />
@if (!visual.Temporal && visual.Points.Count > 8) { <figcaption>@PdfPrintPresentation.SummaryNote(8, visual.Points.Count, p.IsArabic)</figcaption> }
</figure>
} else if (visual.Source == "Practices" && visual.Points.Count > 0) {
var practices = visual.Points.DistinctBy(x => x.Key).OrderBy(x => x.Key, StringComparer.Ordinal).Take(2).ToArray();
var codes = visual.Points.Select(x => x.Metric.MetricCode).Distinct().Take(5).ToArray();
<table><thead><tr><th>@T("Measure", "المقياس")</th>@foreach (var practice in practices) { <th>@practice.Group</th> }@if (practices.Length == 1) { <th>@T("Basis / status", "الأساس والحالة")</th> }</tr></thead><tbody>
@foreach (var code in codes) {
var label = visual.Points.First(x => x.Metric.MetricCode == code).Metric;
<tr data-summary-row="practice"><td>@PdfPrintPresentation.Name(label, p.IsArabic)</td>
@foreach (var practice in practices) {
var m = visual.Points.FirstOrDefault(x => x.Key == practice.Key && x.Metric.MetricCode == code)?.Metric;
<td>@if (m == null) { <span>@T("Not supplied", "غير وارد")</span> } else {
<bdi dir="ltr">@PdfPrintPresentation.Value(m) @ReportPresentationText.Unit(m.Unit, p.IsArabic)</bdi>
@if (practices.Length > 1 && m.DataStatus != ReportDataStatus.NotAvailable && (m.Numerator.HasValue || m.Denominator.HasValue)) { <br /><bdi dir="ltr">@N(m.Numerator) / @N(m.Denominator)</bdi> }
@if (!PdfPrintPresentation.Measured(m) || m.DataStatus != ReportDataStatus.Complete) { <p class="note">@PdfPrintPresentation.MetricState(m, p.IsArabic)</p> }
}</td>
}
@if (practices.Length == 1) { var m = visual.Points.FirstOrDefault(x => x.Key == practices[0].Key && x.Metric.MetricCode == code)?.Metric;
<td>@if (m != null) { @ReportPresentationText.Status(m.DataStatus.ToString(), p.IsArabic)
@if (m.DataStatus != ReportDataStatus.NotAvailable && (m.Numerator.HasValue || m.Denominator.HasValue)) { <br /><bdi dir="ltr">@N(m.Numerator) / @N(m.Denominator)</bdi> }
}</td>
}
</tr>
}
</tbody></table>
<p class="note">@PdfPrintPresentation.SummaryNote(practices.Length, visual.Points.Select(x => x.Key).Distinct().Count(), p.IsArabic, true)</p>
} else if (visual.Table && visual.Points.Count > 0 && visual.Source != "Series") {
var rows = PdfPrintPresentation.VisibleSummaryRows(visual);
<table><thead><tr><th>@T("Group / measure", "المجموعة والمقياس")</th><th>@T("Value / unit", "القيمة والوحدة")</th><th>@T("Basis / status", "الأساس والحالة")</th></tr></thead><tbody>
@foreach (var point in rows) { var m = point.Metric;
<tr data-summary-row="measure"><td>@point.Group<br />@PdfPrintPresentation.Name(m, p.IsArabic)</td><td class="num">@PdfPrintPresentation.Value(m) @ReportPresentationText.Unit(m.Unit, p.IsArabic)</td><td>@ReportPresentationText.Status(m.DataStatus.ToString(), p.IsArabic)
@if (m.DataStatus != ReportDataStatus.NotAvailable && (m.Numerator.HasValue || m.Denominator.HasValue)) { <br /><bdi dir="ltr">@N(m.Numerator) / @N(m.Denominator)</bdi> }
@if (!PdfPrintPresentation.Measured(m)) { <p class="note">@PdfPrintPresentation.MetricState(m, p.IsArabic)</p> }
@if (m.WarningCode != null) { <p class="note">@PdfPrintPresentation.Warning(m.WarningCode, p.IsArabic)</p> }
</td></tr>
}
</tbody></table>
@if (visual.Points.Count > rows.Count) { <p class="note">@PdfPrintPresentation.SummaryNote(rows.Count, visual.Points.Count, p.IsArabic)</p> }
} else { <p class="empty">@PdfPrintPresentation.MissingMeasurementSummary(visual, p.IsArabic)</p> }
</section>
}
@if (comparisons.Length > 0) {
<h2>@T("Headline previous-period comparisons", "مقارنات المؤشرات الرئيسية بالفترة السابقة")</h2><p class="note">@T("Absolute changes in percent metrics are percentage points; relative changes are percentages. Only supplied headline comparisons are shown.", "التغير المطلق لمؤشرات النسب بالنقاط المئوية والتغير النسبي بنسبة مئوية؛ تعرض مقارنات المؤشرات الرئيسية الواردة فقط.")</p>
<table><thead><tr><th>@T("Measure / previous period", "المقياس والفترة السابقة")</th><th>@T("Current / previous", "الحالي والسابق")</th><th>@T("Change / status", "التغير والحالة")</th></tr></thead><tbody>
@foreach (var c in comparisons) { var m = print.Cards.First(x => x.MetricCode == c.MetricCode); var available = c.DataStatus is ReportDataStatus.Complete or ReportDataStatus.Partial;
<tr data-comparison="headline"><td>@PdfPrintPresentation.Name(m, p.IsArabic)<br /><bdi dir="ltr">@c.PreviousFromDate.ToString("yyyy-MM-dd") – @c.PreviousToDate.ToString("yyyy-MM-dd")</bdi></td><td class="num">@(available ? N(c.CurrentValue) : "—") / @(available ? N(c.PreviousValue) : "—") @ReportPresentationText.Unit(m.Unit, p.IsArabic)</td><td><bdi dir="ltr">@(available ? N(c.AbsoluteChange) : "—") @(m.Unit == "percent" ? T("points", "نقطة") : ReportPresentationText.Unit(m.Unit, p.IsArabic)) / @(available ? N(c.RelativeChangePercent) : "—")%</bdi><br />@ReportPresentationText.Status(c.DataStatus.ToString(), p.IsArabic)
@if (c.WarningCode != null) { <p class="note">@PdfPrintPresentation.Warning(c.WarningCode, p.IsArabic)</p> }
</td></tr>
}
</tbody></table>
}
<section class="methodology" id="data-quality"><h2>@T("Data quality & methodology", "جودة البيانات والمنهجية")</h2>
<p>@T("Data status", "حالة البيانات"): @ReportPresentationText.Status(r.DataStatus.ToString(), p.IsArabic) · @T("Eligible / excluded", "المؤهل والمستبعد"): <bdi dir="ltr">@r.EligibleSampleCount / @r.ExcludedSampleCount</bdi></p>
@if (print.QualityNotes.Count > 0) { <p>@string.Join(" · ", print.QualityNotes)</p> }
@if (filters.Length > 0) { <p>@foreach (var filter in filters) { <span><b>@filter.Label:</b> <bdi>@filter.Value</bdi> · </span> }</p> }
<p>@T("Practices may use different time zones; business dates retain source time zones. Snapshot and generation times are UTC. Ratios retain reported denominators; missing observations are never zero.", "قد تختلف المناطق الزمنية للعيادات؛ تواريخ العمل تتبع مناطق المصدر. اللقطة والإنشاء بتوقيت UTC. تحتفظ النسب بمقامات المصدر ولا تستبدل القيم المفقودة بصفر.")</p>
<p>@T("This executive PDF intentionally omits row-level data. Full authorized details remain in XLSX if available under the current permissions.", "يحذف هذا الملخص التنفيذي بيانات الصفوف عمدًا. تبقى التفاصيل الكاملة المصرح بها في XLSX عند إتاحتها وفق الصلاحيات الحالية.")</p>
<p class="note">@PdfPrintPresentation.Confidentiality(r.Scope.Actor, p.IsArabic)</p>
</section></body></html>
